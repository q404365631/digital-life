{
  "name": "shikakeru-digital-life",
  "displayName": "Digital Life by SHIKAKERU",
  "description": "Your code becomes a world. Digital creatures live in your VS Code, reflecting the health of your codebase. Uses ipinfo.io for geolocation and Open-Meteo for weather data (no API key required, no personal data stored).",
  "version": "0.1.0",
  "publisher": "shikakeru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/teamshikakeru-glitch/digital-life"
  },
  "homepage": "https://github.com/teamshikakeru-glitch/digital-life#readme",
  "bugs": {
    "url": "https://github.com/teamshikakeru-glitch/digital-life/issues"
  },
  "preview": false,
  "galleryBanner": {
    "color": "#1A1A1A",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "pet",
    "pixel-art",
    "tamagotchi",
    "digital-life",
    "coding-companion",
    "gamification",
    "creature"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "digital-life",
          "title": "Digital Life",
          "icon": "assets/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "digital-life": [
        {
          "type": "webview",
          "id": "digitalLife.mainView",
          "name": "Digital Life"
        }
      ]
    },
    "commands": [
      {
        "command": "digitalLife.showPanel",
        "title": "Digital Life: Show Panel"
      },
      {
        "command": "digitalLife.resetAll",
        "title": "Digital Life: Reset All (Start Over)"
      },
      {
        "command": "digitalLife.adoptFiles",
        "title": "Digital Life: Adopt Existing Files"
      },
      {
        "command": "digitalLife.clearGraves",
        "title": "Digital Life: Clear Gravestones"
      },
      {
        "command": "digitalLife.toggleAutoCare",
        "title": "Digital Life: Toggle Auto-Care (自動餌やり)"
      },
      {
        "command": "digitalLife.runAutoCareNow",
        "title": "Digital Life: Run Auto-Care Now (今すぐ自動餌やり)"
      },
      {
        "command": "digitalLife.showAutoCareLog",
        "title": "Digital Life: Show Auto-Care Log (自動餌やり履歴)"
      }
    ],
    "configuration": {
      "title": "Digital Life",
      "properties": {
        "digitalLife.realWeather": {
          "type": "boolean",
          "default": true,
          "description": "Show real weather from Open-Meteo API"
        },
        "digitalLife.language": {
          "type": "string",
          "enum": ["auto", "en", "ja", "zh-TW", "zh-CN", "ko", "es"],
          "default": "auto",
          "description": "UI language (auto = follow VS Code language)"
        },
        "digitalLife.sound": {
          "type": "boolean",
          "default": true,
          "description": "Enable sound effects"
        },
        "digitalLife.saveReaction": {
          "type": "boolean",
          "default": true,
          "description": "Show sparkle effect when files are saved"
        },
        "digitalLife.autoCare.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable auto-care mode (自動餌やりモード). Automatically feeds and cares for creatures when their HP drops below threshold."
        },
        "digitalLife.autoCare.intervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 1440,
          "description": "Auto-care check interval in minutes (自動餌やりの間隔). Default: 30 minutes."
        },
        "digitalLife.autoCare.healthThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 100,
          "description": "HP threshold for auto-care (自動餌やりのHP閾値). Creatures with HP at or below this value will be automatically cared for. Default: 50."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "lint": "eslint src --ext ts",
    "compile-tests": "tsc -p ./tsconfig.json"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^8.56.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
